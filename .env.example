# ============================================================
# Crude MCX Signal Dashboard — Environment Configuration
# ============================================================
# STEP 1: Copy this file to .env
#         cp .env.example .env
#
# STEP 2: Fill in your values below
# STEP 3: NEVER share or commit your .env file!
# ============================================================

# --- Upstox API Credentials ---
# Get these from: https://upstox.com/developer/
# Create an app, set redirect URI to: http://127.0.0.1:8000/callback
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- Upstox Access Token (auto-refreshed daily) ---
# Leave blank on first run — the app will guide you to generate it
UPSTOX_ACCESS_TOKEN=

# --- Optional: NewsData.io API (for enhanced news) ---
# Free tier: 200 requests/day — get key at https://newsdata.io/
# Leave blank to use OilPrice.com RSS feed instead (recommended for starters)
NEWSDATA_API_KEY=

# --- Optional: Telegram Alerts ---
# Leave blank to disable Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
